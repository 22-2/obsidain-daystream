{
  "name": "mobile-first-daily-interface",
  "version": "2.0.3",
  "type": "module",
  "description": "TODO",
  "main": "main.js",
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "build:analyze": "vite build -- --analyze",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "check": "pnpm tsc6 --noEmit -skipLibCheck",
    "format": "pnpx organize-imports-cli tsconfig.json && vp format --write ./src && vp lint --fix",
    "pre:push": "pnpm check && pnpm run test",
    "ci": "pnpm install && pnpm run build && pnpm run test",
    "release": "pnpm ci && pnpm version-bump.mts ${VERSION} && git add package.json manifest.json versions.json pnpm.lockb && git commit -m ${VERSION} && git tag ${VERSION} && git push --tags && git push"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
