{
  "name": "obsidian-daystream",
  "version": "2.0.3",
  "type": "module",
  "description": "A daily stream for notes, tasks, and insights in Obsidian.",
  "main": "main.js",
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "build:analyze": "vite build -- --analyze",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "check": "pnpm tsc6 --noEmit -skipLibCheck",
    "format": "pnpx organize-imports-cli tsconfig.json && vp format --write ./src && vp lint --fix",
    "pre:push": "pnpm check && pnpm run test",
    "ci": "pnpm install && pnpm run build && pnpm run test",
    "release": "pnpm ci && pnpm version-bump.mts ${VERSION} && git add package.json manifest.json versions.json pnpm.lockb && git commit -m ${VERSION} && git tag ${VERSION} && git push --tags && git push"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@obsidian-typings/obsidian-public-latest": "^6.38.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/devtools": "^0.7.6",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.4.5",
    "es-toolkit": "^1.52.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jsdom": "30.1.1",
    "moment": "^2.31.0",
    "obsidian-e2e-toolkit": "https://github.com/22-2/obsidian-e2e-toolkit/releases/download/1.7.1/obsidian-e2e-toolkit-1.7.1.tgz",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-inspect": "12.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@22-2/obsidian-magical-editor": "1.0.19",
    "@22-2/obsidian-daily-notes-kit": "workspace:*",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "consola": "^3.4.2",
    "date-fns": "^4.4.0",
    "monkey-around": "^3.0.0",
    "p-queue": "^9.3.3",
    "preact": "^10.29.8",
    "react": "~19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "~19.3.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "virtua": "^0.52.7",
    "worker-timers": "^8.0.34",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "electron": "41.0.3",
    "vite": "^8.0.4"
  },
  "onlyBuiltDependencies": [
    "electron",
    "obsidian-e2e-toolkit"
  ],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  }
}
