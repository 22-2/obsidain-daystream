    "jsdom": "30.0.1",
    "moment": "^2.30.1",
    "obsidian-e2e-toolkit": "github:22-2/obsidian-e2e-toolkit#1.2.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
